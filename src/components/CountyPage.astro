---
/** A county: every 2027 plan at once (finder locked on the county), the folded answer, the text written for
 *  the county, then the 2026 plan IDs that are not renewed here. */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { route, ROUTES } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { stateId, countyId, guideById, statePageById } from '../lib/pages';
import { helpers, SOURCES } from '../lib/helpers';
import { bySlug, stateSummary, statePlans } from '../lib/data';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { CountyDef } from '../lib/page-types';
interface Props { def: CountyDef }
const { def } = Astro.props;
const lang = 'en';
const ui = t(lang);
const ref = bySlug(def.state);
const S = stateSummary(ref.st);
const c = S.countyStats[def.county];
const f = await statePlans(ref.st);
const row = f.counties.find((x) => x.s === def.county)!;
const path = route(countyId(def.state, def.county), lang);
const jsonLd = [articleSchema({ title: def.title, description: def.description, path, lang }), webPageSchema({ name: def.title, description: def.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: ref.name, path: route(stateId(def.state), lang) }, { name: `${c.name} County`, path }])];
if (def.faqs.length) jsonLd.push(faqSchema(def.faqs, lang));
const card = (id: string) => guideById(id)?.card ?? (statePageById(id) ? 'Every county and drug plan of the state' : 'Every 2027 plan of the county');
const related = def.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id), description: card(id) }));
const sources = [{ name: SOURCES.cms_landscape.label, url: SOURCES.cms_landscape.url }, { name: SOURCES.cms_stars_data.label, url: SOURCES.cms_stars_data.url }];
const unit = ref.st === 'LA' ? 'Parish' : 'County';
---
<PageLayout title={def.title} description={def.description} lang={lang} jsonLd={jsonLd} faqs={def.faqs} related={related} sources={sources} breadcrumbs={[{ label: ref.name, href: route(stateId(def.state), lang) }, { label: `${c.name} ${unit}` }]}>
  <article>
    <header class="mb-4">
      <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">Medicare Advantage plans in {c.name} {unit}, {ref.name} (2027)</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{def.intro}</p>
    </header>
    <div data-outil data-chrome class="mb-4"><Tool kind="finder" st={ref.st} county={def.county} lock="county" idPrefix={`co-${def.county.slice(0, 8)}`} /></div>
    <p class="mb-6 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> from the CMS landscape file of September 2026 · <a href={route(stateId(def.state), lang)} class="underline hover:text-navy-900">all {ref.name} counties and drug plans</a></p>
    <Clamp text={def.resume} lang={lang} id={`clamp-${def.county}`} class="mb-8" />
    <Body html={def.body(helpers())} path={path} />
    {row.x.length > 0 && <section class="mt-10" data-chrome>
      <h2 class="font-serif text-2xl font-bold text-navy-900">2026 plans not filed again here for 2027</h2>
      <p class="mt-2 text-sm text-navy-700">These plan IDs were offered in {c.name} {unit} in 2026 and do not appear for the county in the 2027 file. A plan can be closed, moved out of the county or merged into another ID; the insurer must tell its members in the Annual Notice of Change sent by September 30.</p>
      <ul class="mt-3 grid gap-x-6 gap-y-1 text-sm text-navy-800 sm:grid-cols-2">{row.x.map((p) => <li>{p.n} <span class="text-navy-600">({p.o}, {p.k}{p.same ? ', insurer still present' : ''})</span></li>)}</ul>
    </section>}
  </article>
</PageLayout>
