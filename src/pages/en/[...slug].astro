---
/** Every topic page (src/content/guides), state page (src/content/states) and county page (src/content/counties). */
import ContentPage from '../../components/ContentPage.astro';
import StatePage from '../../components/StatePage.astro';
import CountyPage from '../../components/CountyPage.astro';
import { GUIDES, STATE_PAGES, COUNTY_PAGES } from '../../lib/pages';
export function getStaticPaths() {
  return [
    ...GUIDES.map((page) => ({ params: { slug: page.slug }, props: { kind: 'g', def: page } })),
    ...STATE_PAGES.map((def) => ({ params: { slug: def.slug }, props: { kind: 's', def } })),
    ...COUNTY_PAGES.map((def) => ({ params: { slug: `${def.state}/${def.county}` }, props: { kind: 'c', def } })),
  ];
}
const { kind, def } = Astro.props as { kind: 'g' | 's' | 'c'; def: any };
---
{kind === 'g' ? <ContentPage page={def} /> : kind === 's' ? <StatePage def={def} /> : <CountyPage def={def} />}
